# Required for the agent (Phase 2+)
ANTHROPIC_API_KEY=
# Model id used by the agent; keep configurable
ANTHROPIC_MODEL=claude-sonnet-5-5
# mock = fixtures for flights/weather/places/FX; real = call live providers
LIVE_MODE=mock
# fastembed (local ONNX model) or hash (offline, tests only)
EMBEDDINGS=fastembed
# Where SQLite, Chroma and uploads live
TRIPMATE_DATA_DIR=./data
