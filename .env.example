# --- Agent mode: multi (router + specialist agents + citation verifier, default) | single (one agent, all tools) ---
AGENT_MODE=multi
# When no routing rule matches a question, ask the LLM which specialists to use (one extra request, only on a miss; ignored by the demo provider)
ROUTER_LLM_FALLBACK=true
# When the word-overlap check rejects a citation, ask the LLM once whether the passage supports it (rescue-only: it can restore, never remove; numbers must still match; ignored by the demo provider)
VERIFIER_LLM_RESCUE=true
# --- LLM for the chat agent ---
# gemini (default, free tier, key from https://aistudio.google.com/apikey) | openai (any OpenAI-compatible API) | anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Client-side rate limits (-1 = provider default: Gemini 12 requests/min [free tier allows 15] and 500/day; 0 = unlimited)
LLM_MAX_RPM=-1
LLM_DAILY_LIMIT=-1
# For LLM_PROVIDER=openai (e.g. Groq: https://api.groq.com/openai/v1)
# Local model (make local-model, make local-llm): LLM_PROVIDER=openai, LLM_BASE_URL=http://localhost:8080/v1,
#   LLM_MODEL=qwen3-8b, LLM_API_KEY=local  (any non-empty value), LLM_TIMEOUT_SECONDS=180 if answers time out
#   Llama 3.1 8B instead (weaker): make local-model LOCAL_MODEL=llama31 ; make local-llm LOCAL_MODEL=llama31 PORT=8081
#   -> LLM_BASE_URL=http://localhost:8081/v1, LLM_MODEL=llama3.1-8b
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60
# For LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# mock = fixtures for flights/weather/places/FX; real = call live providers
LIVE_MODE=mock
# flights have no real provider yet: keep mock even when LIVE_MODE=real (setting real makes flight lookups fail)
LIVE_FLIGHTS=mock
# onnx (Chroma MiniLM, downloads from AWS S3) | fastembed (needs huggingface.co) | hash (tests only)
EMBEDDINGS=onnx
# Where SQLite, Chroma and uploads live
TRIPMATE_DATA_DIR=./data
